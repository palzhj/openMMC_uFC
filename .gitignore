# ---- in-source build tree (keep only the build guide) ----
/build/*
!/build/readme.md

# ---- out-of-tree build / staging dirs ----
/.hw2/
/out/
*.log

# ---- build artifacts ----
*.o
*.d
*.su
*.elf
*.bin
*.srec
*.hex
*.map
*.lst
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# ---- third-party documents: vendor/CERN copies, not redistributable ----
/docs/datasheets/
/docs/specs/

# ---- local Renode home ----
/.renode-home/

# ---- release archives ----
/dist/

# ---- generated release metadata ----
/firmware/ufc-v2/BUILD_INFO.txt

# FRU GUI build artifacts
tools/uFC_toolbox/dist/
tools/uFC_toolbox/build/
tools/uFC_toolbox/__pycache__/

# clock configuration preset (small binary, part of the production data)
!tools/clocking/*-clk-preset.bin
