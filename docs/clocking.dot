digraph clocking {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF",
        color="#E4DED2", fontname="Helvetica", fontsize=8];
  edge [fontname="Helvetica", fontsize=7];
  subgraph "cluster_board_ufc" { label="board uFC v2.0"; fontsize=10; color="#EDEAE2";
    subgraph "cluster_MUX" { label="MUX 8V54816A"; fontsize=9; color="#FAF9F5";
      "MUX.CLK0" [label="CLK0 in\npin 6/7", shape=note];
      "MUX.CLK1" [label="CLK1 in\npin 10/11", shape=note];
      "MUX.CLK2" [label="CLK2 in\npin 15/16", shape=note];
      "MUX.CLK3" [label="CLK3 in\npin 19/20", shape=note];
      "MUX.CLK4" [label="CLK4 in\npin 31/32", shape=note];
      "MUX.CLK5" [label="CLK5 out\npin 35/36", shape=note];
      "MUX.CLK6" [label="CLK6 out\npin 40/41", shape=note];
      "MUX.CLK7" [label="CLK7 in\npin 44/45", shape=note];
      "MUX.CLK8" [label="CLK8 in\npin 56/57", shape=note];
      "MUX.CLK9" [label="CLK9 out\npin 60/61", shape=note];
      "MUX.CLK10" [label="CLK10 out\npin 65/66", shape=note];
      "MUX.CLK11" [label="CLK11 out\npin 69/70", shape=note];
      "MUX.CLK12" [label="CLK12 in\npin 81/82", shape=note];
      "MUX.CLK13" [label="CLK13 in\npin 85/86", shape=note];
      "MUX.CLK14" [label="CLK14 in\npin 89/90", shape=note];
      "MUX.CLK15" [label="CLK15 in\npin 94/95", shape=note];
    }
    subgraph "cluster_S7" { label="FPGA Spartan 7"; fontsize=9; color="#FAF9F5";
      "S7.CLK_INOUT" [label="CLK_INOUT in\npin F14"];
      "S7.CLK_IN0" [label="CLK_IN0 in\npin N15"];
      "S7.CLK_IN1" [label="CLK_IN1 in\npin D14"];
      "S7.CLK_OUT0" [label="CLK_OUT0 out\npin B16"];
      "S7.CLK_OUT1" [label="CLK_OUT1 out\npin B17"];
      "S7.CLK_OUT2" [label="CLK_OUT2 out\npin F18"];
      "S7.CLK_OUT3" [label="CLK_OUT3 out\npin C17"];
      "S7.FMC0_GTXCLK1_M2C" [label="FMC0_GTXCLK1_M2C in\npin G16"];
      "S7.FMC0_CLK2_BIDIR" [label="FMC0_CLK_M2C in\npin D18"];
      "S7.FMC0_CLK3_BIDIR" [label="FMC0_CLK_M2C in\npin D18"];
      "S7.FMC1_GTXCLK1_M2C" [label="FMC1_GTXCLK1_M2C in\npin R14"];
      "S7.FMC1_CLK2_BIDIR" [label="FMC1_CLK_M2C in\npin D18"];
      "S7.FMC1_CLK3_BIDIR" [label="FMC1_CLK_M2C in\npin D18"];
      "S7.MGTCLK115_1" [label="MGTCLK115_1 out\npin U17"];
      "S7.MGTCLK116_1" [label="MGTCLK116_1 out\npin U17"];
      "S7.MGTCLK118_1" [label="MGTCLK118_1 out\npin U17"];
    }
    subgraph "cluster_AMC" { label="AMC"; fontsize=9; color="#FAF9F5";
      "AMC.TCLKA" [label="TCLKA out"];
      "AMC.TCLKB" [label="TCLKB out"];
      "AMC.TCLC" [label="TCLC out"];
      "AMC.TCLKD" [label="TCLKD out"];
      "AMC.FCLKA" [label="FCLKA out"];
    }
    subgraph "cluster_FMC0" { label="FMC0"; fontsize=9; color="#FAF9F5";
      "FMC0.GBTCLK0_M2C" [label="GBTCLK0_M2C out"];
      "FMC0.GBTCLK1_M2C" [label="GBTCLK1_M2C out"];
      "FMC0.CLK0_M2C" [label="CLK0_M2C out"];
      "FMC0.CLK1_M2C" [label="CLK1_M2C out"];
      "FMC0.CLK2_BIDIR" [label="CLK2_BIDIR in"];
      "FMC0.CLK3_BIDIR" [label="CLK3_BIDIR in"];
    }
    subgraph "cluster_mcu" { label="MCU"; fontsize=9; color="#FAF9F5";
      "mcu.CLK" [label="CLK in"];
    }
    subgraph "cluster_FMC1" { label="FMC1"; fontsize=9; color="#FAF9F5";
      "FMC1.GBTCLK0_M2C" [label="GBTCLK0_M2C out"];
      "FMC1.GBTCLK1_M2C" [label="GBTCLK1_M2C out"];
      "FMC1.CLK0_M2C" [label="CLK0_M2C out"];
      "FMC1.CLK1_M2C" [label="CLK1_M2C out"];
      "FMC1.CLK2_BIDIR" [label="CLK2_BIDIR in"];
      "FMC1.CLK3_BIDIR" [label="CLK3_BIDIR in"];
    }
    subgraph "cluster_osc156" { label="156.25 MHz"; fontsize=9; color="#FAF9F5";
      "osc156.OUT" [label="OUT out"];
    }
    subgraph "cluster_K7" { label="FPGA Kintex 7"; fontsize=9; color="#FAF9F5";
      "K7.REFCLK" [label="REFCLK in\npin T26"];
      "K7.SRCC" [label="SRCC in\npin R28"];
      "K7.MRCC0" [label="MRCC0 in\npin AD23"];
      "K7.MRCC1" [label="MRCC1 in\npin AB27"];
      "K7.MRCC2" [label="MRCC2 in\npin AG29"];
      "K7.MRCC3" [label="MRCC3 in\npin C25"];
      "K7.MRCC4" [label="MRCC4 in\npin D27"];
      "K7.MRCC5" [label="MRCC5 in\npin F20"];
      "K7.MRCC6" [label="MRCC6 in\npin D17"];
      "K7.LEMO_CLK" [label="LEMO_CLK in\npin U27"];
      "K7.MGTCLK115_0" [label="MGTCLK115_0 in\npin R8"];
      "K7.MGTCLK115_1" [label="MGTCLK115_1 in\npin R8"];
      "K7.MGTCLK116_0" [label="MGTCLK116_0 in\npin L8"];
      "K7.MGTCLK116_1" [label="MGTCLK116_1 in\npin N8"];
      "K7.MGTCLK117_0" [label="MGTCLK117_0 in\npin G8"];
      "K7.MGTCLK117_1" [label="MGTCLK117_1 in\npin J8"];
      "K7.MGTCLK118_0" [label="MGTCLK118_0 in\npin C8"];
      "K7.MGTCLK118_1" [label="MGTCLK118_1 in\npin E8"];
      "K7.CLK_INOUT" [label="CLK_INOUT in"];
    }
    subgraph "cluster_PLL" { label="PLL Si5345A"; fontsize=9; color="#FAF9F5";
      "PLL.IN2" [label="IN2 in"];
      "PLL.IN1" [label="IN1 in"];
      "PLL.IN0" [label="IN0 in"];
      "PLL.OUT9" [label="OUT9 out"];
      "PLL.OUT8" [label="OUT8 out"];
      "PLL.OUT7" [label="OUT7 out"];
      "PLL.OUT6" [label="OUT6 out"];
      "PLL.OUT5" [label="OUT5 out"];
      "PLL.OUT4" [label="OUT4 out"];
      "PLL.OUT3" [label="OUT3 out"];
      "PLL.OUT2" [label="OUT2 out"];
      "PLL.OUT1" [label="OUT1 out"];
      "PLL.OUT0" [label="OUT0 out"];
    }
    subgraph "cluster_wr" { label="White Rabbit"; fontsize=9; color="#FAF9F5";
      "wr.OUT" [label="125MHz out"];
    }
    subgraph "cluster_osc200" { label="200 MHz"; fontsize=9; color="#FAF9F5";
      "osc200.OUT" [label="OUT out"];
    }
    subgraph "cluster_osc8" { label="8 MHz"; fontsize=9; color="#FAF9F5";
      "osc8.OUT" [label="OUT out"];
    }
    subgraph "cluster_vcxo" { label="VCXO 20 MHz"; fontsize=9; color="#FAF9F5";
      "vcxo.OUT" [label="OUT out"];
    }
    subgraph "cluster_lemo" { label="LEMO_CLK_IN"; fontsize=9; color="#FAF9F5";
      "lemo.OUT" [label="CLK out"];
    }
  }
  "AMC.TCLKD" -> "MUX.CLK0" [color="#8A8A80"];
  "AMC.TCLC" -> "MUX.CLK1" [color="#8A8A80"];
  "AMC.TCLKA" -> "MUX.CLK2" [color="#8A8A80"];
  "AMC.TCLKB" -> "MUX.CLK3" [color="#8A8A80"];
  "AMC.FCLKA" -> "MUX.CLK4" [color="#8A8A80"];
  "MUX.CLK5" -> "S7.CLK_INOUT" [color="#8A8A80"];
  "MUX.CLK6" -> "K7.CLK_INOUT" [color="#8A8A80", style=dashed];
  "osc156.OUT" -> "MUX.CLK7" [color="#8A8A80"];
  "PLL.OUT9" -> "MUX.CLK8" [color="#8A8A80"];
  "MUX.CLK9" -> "PLL.IN2" [color="#8A8A80"];
  "MUX.CLK10" -> "PLL.IN1" [color="#8A8A80"];
  "MUX.CLK11" -> "PLL.IN0" [color="#8A8A80"];
  "FMC0.GBTCLK0_M2C" -> "MUX.CLK12" [color="#8A8A80"];
  "FMC0.CLK0_M2C" -> "MUX.CLK13" [color="#8A8A80"];
  "FMC1.CLK0_M2C" -> "MUX.CLK14" [color="#8A8A80"];
  "FMC1.GBTCLK0_M2C" -> "MUX.CLK15" [color="#8A8A80"];
  "FMC0.GBTCLK0_M2C" -> "S7.FMC0_GTXCLK1_M2C" [color="#8A8A80"];
  "FMC0.CLK0_M2C" -> "S7.FMC0_CLK2_BIDIR" [color="#8A8A80"];
  "FMC1.GBTCLK0_M2C" -> "S7.FMC1_GTXCLK1_M2C" [color="#8A8A80"];
  "FMC1.CLK0_M2C" -> "S7.FMC1_CLK2_BIDIR" [color="#8A8A80"];
  "PLL.OUT0" -> "K7.MGTCLK116_0" [color="#8A8A80", style=dashed];
  "PLL.OUT1" -> "K7.MGTCLK116_1" [color="#8A8A80", style=dashed];
  "PLL.OUT2" -> "K7.MGTCLK117_0" [color="#8A8A80", style=dashed];
  "PLL.OUT3" -> "K7.MGTCLK117_1" [color="#8A8A80", style=dashed];
  "PLL.OUT4" -> "K7.MRCC3" [color="#8A8A80", style=dashed];
  "osc200.OUT" -> "K7.REFCLK" [color="#8A8A80"];
  "osc200.OUT" -> "K7.MRCC0" [color="#8A8A80", style=dashed];
  "wr.OUT" -> "K7.MRCC1" [color="#8A8A80"];
  "wr.OUT" -> "S7.CLK_IN1" [color="#8A8A80"];
  "vcxo.OUT" -> "K7.MRCC2" [color="#8A8A80"];
  "lemo.OUT" -> "K7.LEMO_CLK" [color="#8A8A80"];
  "osc8.OUT" -> "mcu.CLK" [color="#8A8A80"];
  "MUX.CLK7" -> "MUX.CLK11" [label="routing", color="#B07A3A", penwidth=2];
  "MUX.CLK8" -> "MUX.CLK12" [label="routing", color="#B07A3A", penwidth=2];
  "MUX.CLK7" -> "MUX.CLK14" [label="routing", color="#B07A3A", penwidth=2];
}
