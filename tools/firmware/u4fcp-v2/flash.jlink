// u4FCP-v2 J-Link programming (SWD) — newboot (first stage) + application.
//
// Run from tools/firmware/u4fcp-v2/ :  JLinkExe -CommanderScript flash.jlink
//
// 128 KB layout: newboot 0x08000000..0x08001FFF (8 KB),
// application 0x08002000..0x08010DFF (59.5 KB),
// staging 0x08010E00..0x0801FBFF (59.5 KB), fw_info 0x0801FC00.
// The clock configuration lives in the CAT24C512 EEPROM.
device STM32F103CB
si SWD
speed 1000
VTREF 3300
connect
loadfile uart-debug/newboot.bin 0x08000000
loadfile uart-debug/openMMC.bin 0x08002000
r
g
q
