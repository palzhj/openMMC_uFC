// uFC-v2 J-Link programming (SWD) — newboot (first stage) + application.
//
// Run from tools/firmware/ufc-v2/ :  JLinkExe -CommanderScript flash.jlink
//
// newboot sits at the reset vector (0x08000000)
// and jumps to the application at 0x08002000.  The staging area
// (0x0800E800-0x0801AFFF) and the fw_info record (0x0801FC00) are left untouched.
device STM32F100CB
si SWD
speed 1000
VTREF 3300
connect
loadfile uart-debug/newboot.bin 0x08000000
loadfile uart-debug/openMMC.bin 0x08002000
r
g
q
