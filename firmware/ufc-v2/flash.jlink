// uFC-v2 J-Link programming (SWD) — newboot (first stage) + application.
//
// Run from firmware/ufc-v2/ :  JLinkExe -CommanderScript flash.jlink
//
// OpenBLT is no longer used: newboot sits at the reset vector (0x08000000)
// and jumps to the application at 0x08004000.  The staging area
// (0x08012000) and the fw_info record (0x0801FF00) are left untouched.
device STM32F100CB
si SWD
speed 1000
VTREF 3300
connect
loadfile uart-debug/newboot.bin 0x08000000
loadfile uart-debug/openMMC.bin 0x08001C00
r
g
q
